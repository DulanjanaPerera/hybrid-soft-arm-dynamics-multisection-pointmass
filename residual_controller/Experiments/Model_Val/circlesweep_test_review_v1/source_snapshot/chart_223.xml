      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function lout = config2length(u)
%#codegen
% Convert configuration variables to length changes
% Input (u):
%   u       : theta and phi [2x1] (rad)
%               theta angle (rad) [constant]
%               phi angle (rad) [constant]
%   r       : radial offset (m) [constant]
% 
% Output:
%   lout    : lenght changes (m) [s,1]


theta = u(1);
phi = u(2);
r = 0.013;

l = [-r * cos(theta) * phi;
    (0.5e0 * r * cos(theta) - sqrt(0.3e1) * r * sin(theta) / 0.2e1) * phi;
    (0.5e0 * r * cos(theta) + sqrt(0.3e1) * r * sin(theta) / 0.2e1) * phi];

lout = [l(2); l(3)];

end</P>
      </eml>
