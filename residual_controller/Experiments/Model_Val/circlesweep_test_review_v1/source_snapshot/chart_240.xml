        <P Name="script">function [predictionLength_m,predictionAtMeasurement_m,retimedPrediction_m, ...
    shadowDiagnostic,inverseContext]=rlResidualShadowBlock( ...
    lengths3_m,orientationValid,baseValid,pollStart_s,tipFrame,pressure_bar, ...
    commandTime_sim_s,t_sim_s,reset,shadowOptions)
%RLRESIDUALSHADOWBLOCK Paste into a separate discrete0.05s MATLAB Function.
% Observation ONLY. Never connect any output to pressure/control/Kill inputs.
% Output columns: augmented, nominal, constant velocity. See SHADOW_VALIDATION.md.
%#codegen
persistent state
if isempty(state),state=residualShadowInitialState();end
network=residualControllerNetwork(shadowOptions(1));
[predictionLength_m,predictionAtMeasurement_m,retimedPrediction_m, ...
 shadowDiagnostic,inverseContext,state]=residualShadowStep( ...
 lengths3_m,orientationValid,baseValid,pollStart_s,tipFrame,pressure_bar, ...
 commandTime_sim_s,t_sim_s,reset,shadowOptions,state,network);
end
